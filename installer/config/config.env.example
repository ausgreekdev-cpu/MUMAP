# Multi-Agent Platform Configuration
# Copy this file to /etc/multi-agent-platform/config.env

# Security (CHANGE THIS!)
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:////var/lib/multi-agent-platform/multi_agent.db

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/multi-agent-platform/multi-agent.log
